# Settings for the server (docker-compose.prod.yml). Copy this file to .env
# and fill in the values; every password can be any long random string, e.g.
# from: openssl rand -hex 24

# use the production compose file for every "docker compose" command
COMPOSE_FILE=docker-compose.prod.yml

# the server's host name: its IP with dashes plus .sslip.io, e.g.
# 130-61-12-34.sslip.io (Caddy then sets up HTTPS automatically)
SITE_ADDRESS=http://localhost

DB_PASSWORD=change-me
REDIS_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me
# at least 8 characters
INFLUXDB_PASSWORD=change-me
INFLUXDB_TOKEN=change-me
JWT_SECRET=change-me

# password of the public demo accounts (demo-admin, demo-manager, demo-customer)
DEMO_PASSWORD=demo1234
